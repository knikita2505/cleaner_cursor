        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "似た写真は余分な容量を使います。似た写真機能で重複を見つけて削除し、ベストショットだけを残しましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
