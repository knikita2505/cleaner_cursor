    "Short videos (under 10 seconds) often include accidental recordings, failed takes, or unnecessary clips that take up storage." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los videos cortos (menos de 10 segundos) suelen ser grabaciones accidentales, tomas fallidas o clips innecesarios que ocupan espacio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10秒未満の短いビデオには、誤撮影、失敗したテイク、不要なクリップなど、容量を圧迫するものが多く含まれます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeos curtos (menos de 10 segundos) costumam ser gravações acidentais, takes falhos ou clipes desnecessários que ocupam espaço."
          }
        }
      }
    },
