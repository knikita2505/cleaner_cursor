    "Low Power Mode reduces background activity, automatic downloads, and some visual effects. Enable it to extend battery life when you need it most." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low Power Mode reduce la actividad en segundo plano, las descargas automáticas y algunos efectos. Actívalo cuando más necesites alargar la batería."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low Power Modeはバックグラウンド動作、自動ダウンロード、一部の視覚効果を抑えます。バッテリーを長持ちさせたいときにオンにしましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Low Power Mode reduz atividade em segundo plano, downloads automáticos e alguns efeitos. Ative para prolongar a bateria quando mais precisar."
          }
        }
      }
    },
